// Prisma schema — Thu_vien_hoa_tiet
// DB: Supabase Postgres (chỉ dùng làm database, auth/file nằm ngoài)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  passwordHash String
  role         Role              @default(CUSTOMER)
  orders       Order[]
  downloads    DownloadRecord[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  price       Int // giá VND, kiểu integer
  format      String // DXF, DWG, AI, PDF...
  fileKey     String // key file gốc trên R2 (bucket private)
  fileName    String
  fileSize    Int // bytes
  fileExt     String
  imageKeys   String[] // ảnh preview
  specs       Json? // thông số kỹ thuật dạng { key: value }
  license     String?
  isActive    Boolean       @default(true)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  downloads   DownloadRecord[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Order {
  id          String        @id @default(cuid())
  code        String        @unique // mã đơn hiển thị, VD TVT-XXXXXX
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  status      OrderStatus   @default(PENDING)
  total       Int
  vnpTxnRef   String? // mã giao dịch VNPay
  paymentInfo Json? // payload IPN
  items       OrderItem[]
  createdAt   DateTime      @default(now())
  paidAt      DateTime?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  title     String // snapshot tiêu đề lúc mua
  price     Int // snapshot giá lúc mua
}

model DownloadRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  orderId   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
}
