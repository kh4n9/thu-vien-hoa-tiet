# ===== Database (Supabase Postgres) =====
# Lấy từ Supabase > Project Settings > Database > Connection string
# - DATABASE_URL: connection string POOLER (Transaction, port 6543) + ?pgbouncer=true
#   (chuẩn cho Prisma trên serverless — tránh lỗi "prepared statement already exists")
# - DIRECT_URL: connection string SESSION pooler (port 5432) cho `prisma migrate` / `db pull`
DATABASE_URL="postgresql://postgres.cgzcvcrhzrhrfwwusrkj:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.cgzcvcrhzrhrfwwusrkj:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ===== NextAuth (Auth.js v5) =====
# Tạo bằng: npx auth secret  (bắt buộc, dùng ký session cookie)
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai"
# (tuỳ chọn) URL site khi deploy, VD https://thuvienhoatiet.vn
AUTH_URL="http://localhost:3000"

# ===== Admin mặc định (seed) =====
# Tài khoản admin đầu tiên được tạo khi chạy seed
ADMIN_EMAIL="admin@thuvienhoatiet.vn"
ADMIN_PASSWORD="doi-mat-khau-nay"

# ===== Cloudflare R2 =====
# Tạo tại Cloudflare Dashboard > R2 > API Tokens
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET="thuvien-hoa-tiet"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# ===== VNPay (sandbox trước) =====
# Đăng ký tại https://sandbox.vnpayment.vn -> lấy TmnCode + SecretKey
VNPAY_TMN_CODE="your-tmn-code"
VNPAY_HASH_SECRET="your-secret-key"
VNPAY_RETURN_URL="http://localhost:3000/checkout/return"
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_IPN_URL="http://localhost:3000/api/vnpay/ipn"
